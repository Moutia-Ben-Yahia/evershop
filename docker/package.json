{
  "name": "evershop-docker",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime project for the official evershop/evershop image. The @evershop/evershop dependency is added at build time, pinned to the exact released version.",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "setup": "evershop install",
    "seed": "evershop seed",
    "start": "node init && evershop start",
    "start:debug": "node init && evershop start --debug",
    "build": "node init && evershop build",
    "user:create": "evershop user:create",
    "user:changePassword": "evershop user:changePassword",
    "theme:active": "evershop theme:active",
    "theme:create": "evershop theme:create"
  }
}
